{
  "name": "@dsh-store/plugin",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "In-app DSH Store host plugin. Registers settings.plugins.tab only.",
  "main": "./dist/host/index.js",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/wrap-client.mjs",
    "prepack": "pnpm build",
    "test": "tsc -p tsconfig.json && node ./scripts/wrap-client.mjs && node --test dist/core/*.test.js dist/host/*.test.js dist/client/*.test.js",
    "isolate": "tsc -p tsconfig.json && node ./scripts/wrap-client.mjs && node dist/cli/isolate.js",
    "wrap-client": "node ./scripts/wrap-client.mjs"
  },
  "dependencies": {
    "@dsh-store/protocol": "workspace:*",
    "@dsh-store/registry": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.8",
    "typescript": "^5.9.2"
  }
}
