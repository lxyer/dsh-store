{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.dsh.dev/protocol/passport.json",
  "title": "Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pluginId",
    "versionId",
    "scannerVersion",
    "checkedAt",
    "trustState",
    "manifest",
    "license",
    "lifecycleScripts",
    "signals",
    "compatibility",
    "filesInspected",
    "findings"
  ],
  "properties": {
    "id": { "$ref": "ids.json#/$defs/passportId" },
    "pluginId": { "$ref": "ids.json#/$defs/pluginId" },
    "versionId": { "$ref": "ids.json#/$defs/versionId" },
    "scannerVersion": { "type": "integer", "minimum": 1 },
    "checkedAt": { "type": "string", "format": "date-time" },
    "trustState": { "$ref": "ids.json#/$defs/trustState" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hasBundle", "hasClient", "packageName", "subpath"],
      "properties": {
        "hasBundle": { "type": "boolean" },
        "hasClient": { "type": "boolean" },
        "packageName": { "type": ["string", "null"] },
        "subpath": { "type": ["string", "null"] }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx"],
      "properties": {
        "spdx": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] }
      }
    },
    "lifecycleScripts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["preinstall", "install", "prepare", "postinstall"]
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "fs", "credentials", "dynamicEval"],
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "fs": { "type": "array", "items": { "type": "string" } },
        "credentials": { "type": "array", "items": { "type": "string" } },
        "dynamicEval": { "type": "array", "items": { "type": "string" } },
        "uiHijack": { "type": "array", "items": { "type": "string" } }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dshRange", "profiles", "desktop"],
      "properties": {
        "dshRange": { "type": "string" },
        "profiles": {
          "type": "array",
          "items": { "$ref": "ids.json#/$defs/profileName" }
        },
        "desktop": { "type": "string", "enum": ["yes", "no", "unknown"] }
      }
    },
    "filesInspected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "label"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "label": { "$ref": "ids.json#/$defs/bilingual" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disclaimer": {
      "type": "string",
      "const": "Static evidence is not a complete audit and not a runtime sandbox."
    }
  }
}
