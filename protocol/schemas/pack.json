{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://store.dsh.dev/protocol/pack.json",
  "title": "Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "kind",
    "profileTarget",
    "entries",
    "installPolicy"
  ],
  "properties": {
    "id": { "$ref": "ids.json#/$defs/packId" },
    "version": { "$ref": "ids.json#/$defs/semver" },
    "title": { "$ref": "ids.json#/$defs/bilingual" },
    "description": { "$ref": "ids.json#/$defs/bilingual" },
    "kind": { "type": "string", "enum": ["official", "community", "user", "solution"] },
    "profileTarget": { "$ref": "ids.json#/$defs/profileName" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "version", "role"],
        "properties": {
          "ref": { "$ref": "ids.json#/$defs/pluginId" },
          "version": { "$ref": "ids.json#/$defs/versionId" },
          "role": { "type": "string", "enum": ["required", "optional", "alreadyCovered"] }
        }
      }
    },
    "mutexGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "policy"],
        "properties": {
          "id": { "type": "string" },
          "policy": { "type": "string", "enum": ["single"] },
          "members": {
            "type": "array",
            "items": { "$ref": "ids.json#/$defs/pluginId" }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin", "reason"],
        "properties": {
          "plugin": { "$ref": "ids.json#/$defs/pluginId" },
          "reason": { "type": "string" }
        }
      }
    },
    "capabilityCoverage": {
      "type": "array",
      "items": { "$ref": "ids.json#/$defs/capabilityId" }
    },
    "installPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopOnBlocked", "requirePassport", "allowCandidate"],
      "properties": {
        "stopOnBlocked": { "type": "boolean" },
        "requirePassport": { "type": "boolean" },
        "allowCandidate": { "type": "boolean" }
      }
    },
    "completeness": { "type": "string", "enum": ["complete", "partial"] }
  }
}
