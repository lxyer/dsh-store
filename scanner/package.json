{
  "name": "@dsh-store/scanner",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Read-only discovery and passport scanner. Never executes third-party plugin code.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dsh-store-scan": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "scan": "tsc -p tsconfig.json && node dist/cli.js",
    "discover": "tsc -p tsconfig.json && node dist/cli.js"
  },
  "dependencies": {
    "@dsh-store/protocol": "workspace:*",
    "@dsh-store/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
